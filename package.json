{
  "name": "mm2-item-info",
  "version": "0.1.0",
  "description": "An open-source CLI tool that returns you the information of a weapon/pet/misc item in Murder Mystery 2.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "publish:npm": "pnpm publish --access public"
  },
  "main": "dist/index.js",
  "bin": {
    "mm2-item-info": "./dist/index.js"
  },
  "keywords": [
    "roblox",
    "murder mystery 2",
    "murder mystery 2 values",
    "murder mystery 2 value checker",
    "mm2",
    "mm2 values",
    "mm2 value checker"
  ],
  "author": "anth0nycodes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anth0nycodes/mm2-item-info.git"
  },
  "homepage": "https://github.com/anth0nycodes/mm2-item-info#readme",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "axios": "^1.19.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  }
}
