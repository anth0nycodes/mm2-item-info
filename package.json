{
  "name": "@anth0nycodes/mm2-item-info",
  "version": "1.0.3",
  "description": "An open-source CLI tool that returns you the information of a weapon/pet/misc item in Murder Mystery 2.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "publish:npm": "pnpm publish --access public"
  },
  "main": "dist/index.js",
  "bin": {
    "mm2-item-info": "./dist/index.js"
  },
  "keywords": [
    "roblox",
    "murder mystery 2",
    "murder mystery 2 values",
    "murder mystery 2 value checker",
    "mm2",
    "mm2 values",
    "mm2 value checker"
  ],
  "author": "anth0nycodes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anth0nycodes/mm2-item-info.git"
  },
  "bugs": {
    "url": "https://github.com/anth0nycodes/mm2-item-info/issues"
  },
  "homepage": "https://github.com/anth0nycodes/mm2-item-info#readme",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "axios": "^1.19.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "sharp": "^0.35.3",
    "terminal-image": "^5.0.1"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
